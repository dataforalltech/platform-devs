# deploy-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:deploy-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# ── Backend do tenant / LEDGER (ORM canônico, dual-db, credencial-zero) ───────
# deploy-mcp persiste um ledger das operações no banco DO TENANT. A credencial REAL
# vem de ADMIN_DATAFORALL.PLATFORMS (resolvida pela lib a partir do tenant_id dos
# claims). Estes DB_* são o fallback compartilhado. DB_ENGINE decide o dialeto
# (mysql | postgresql). STD-SEC-004: nunca senha no código.
DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASSWORD=

# ── Conexão admin (lê ADMIN_DATAFORALL.PLATFORMS p/ resolver tenant->credencial) ──
# Obrigatória em cloud (enforce_security_invariants). O db name é fixo ADMIN_DATAFORALL.
ADMIN_DB_HOST=
ADMIN_DB_PORT=3306
ADMIN_DB_USER=root
ADMIN_DB_PASSWORD=

# Vault opt-in (STD-SEC-004). Se setado, DB_PASSWORD/ADMIN_DB_PASSWORD (e o PAT/ACR)
# são resolvidos via Vault com fallback gracioso para os valores de env. VAZIO = só env.
VAULT_ADDR=

# Backend GitHub (obrigatório — sem default no código; STD-SEC-004).
# PAT com escopos repo + workflow. NUNCA committar um valor real.
DEPLOY_GITHUB_TOKEN=
DEPLOY_GITHUB_ORG=dataforalltech
DEPLOY_DEFAULT_BASE_BRANCH=develop

# Azure Container Registry (acr_username/acr_password opcionais — só p/ list_acr_images).
DEPLOY_ACR_REGISTRY=d4all.azurecr.io
DEPLOY_ACR_NAMESPACE=dataforall/3.0
DEPLOY_ACR_USERNAME=
DEPLOY_ACR_PASSWORD=

# Workspace local (opcional — pasta raiz dos repos clonados).
DEPLOY_REPOS_ROOT=
