# .env.services.example — SÓ senhas/tokens/chaves dos serviços.
# (as demais variáveis já estão preenchidas no docker-compose.services.yml)
# Copie para .env e preencha. Pode ser o MESMO .env da infra.

# Devem casar com os valores usados no docker-compose.infra.yml:
MYSQL_ROOT_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
VAULT_ROOT_TOKEN=

# Segredos dos serviços:
INTERNAL_API_TOKEN=                 # openssl rand -base64 48
JWT_PRIVATE_KEY_CONTENT=            # PEM da chave RSA privada (uma linha, \n escapados) — só o platform-auth usa

# Opcional (não é senha): tag das imagens no ACR (default: latest)
# IMAGE_TAG=v1.3.0
