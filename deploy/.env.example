# ============================================================================
# .env.example — variáveis do stack do piloto MCP (docker-compose.pilot.yml)
# ----------------------------------------------------------------------------
# Copie para a RAIZ do repo como `.env` e preencha:
#   cp deploy/.env.example .env
#
# NÃO comite o `.env` real. Aqui só há PLACEHOLDERS seguros — nenhum segredo.
# Em produção, prefira injetar estas variáveis por um secrets manager
# (AWS Secrets Manager / SSM / Vault) em vez de arquivo em disco.
# ============================================================================

# ----------------------------------------------------------------------------
# Domínio público (o único host exposto pelo Caddy).
# Troque "mcp.suaempresa.com" pelo seu domínio real AQUI e no deploy/Caddyfile.
# Para dev local com `tls internal`, use https://localhost nos valores abaixo.
# ----------------------------------------------------------------------------

# Base pública única (host do Caddy). Os serviços (exceto security) derivam daqui
# seus RESOURCE/PRM: <base>/<serviço>/mcp e <base>/<serviço>/.well-known/...
MCP_PUBLIC_BASE_URL=https://mcp.suaempresa.com

# Issuer do Authorization Server = host público + prefixo /auth.
# O auth-mcp constrói token_endpoint, jwks_uri e metadata a partir daqui.
AS_ISSUER=https://mcp.suaempresa.com/auth

# "Resource" (audience) do Security = URL PÚBLICA do endpoint /mcp via Caddy.
# É o `aud` que o AS coloca nos tokens e que o Security valida.
SECURITY_RESOURCE=https://mcp.suaempresa.com/security/mcp

# URL PÚBLICA do Protected Resource Metadata (RFC 9728) do Security.
# É o path que o Claude Code busca ao receber 401 (dispara o fluxo OAuth).
SECURITY_PRM_URL=https://mcp.suaempresa.com/security/.well-known/oauth-protected-resource

# JWKS do AS visto pelo Security. Como ambos estão na MESMA rede privada, o
# Security busca as chaves direto pelo host interno (mais rápido, não passa pela
# borda). Deixe assim, a não ser que o AS rode fora do compose.
AS_JWKS_URL=http://auth-mcp:7103/.well-known/jwks.json

# ----------------------------------------------------------------------------
# Chave RSA de assinatura do Authorization Server (PKCS8 PEM).
# ----------------------------------------------------------------------------
# SEM esta variável, o auth-mcp gera uma chave EFÊMERA a cada boot — os tokens
# morrem no restart e não há rotação. DEFINA em produção.
#
# Gere uma chave (PKCS8, RSA 2048+):
#   openssl genpkey -algorithm RSA -pkcs8 -out as_key.pem -pkeyopt rsa_keygen_bits:2048
#
# Passe o CONTEÚDO do PEM (multilinha) para a env. Duas formas:
#   a) exportar direto do arquivo no shell antes do `docker compose`:
#        export AS_PRIVATE_KEY_PEM="$(cat as_key.pem)"
#   b) colar no .env como uma única linha com \n literais (o loader aceita PEM
#      multilinha entre aspas em muitos shells; se der problema, use a opção a).
#
# Exemplo (NÃO use esta — é só ilustrativa do formato):
# AS_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
AS_PRIVATE_KEY_PEM=

# Key ID publicado no JWKS (correlaciona token↔chave; útil na rotação).
AS_KID=auth-mcp-key-1

# TTL dos access tokens, em segundos.
AS_TOKEN_TTL=3600

# ----------------------------------------------------------------------------
# Clients OAuth (grant client_credentials) — bootstrap.
# ----------------------------------------------------------------------------
# SEM esta variável, o AS cria um client de DEMO (security-dev / dev-secret-change-me)
# — SÓ para dev. Em produção, defina AS_CLIENTS_JSON.
#
# Formato: um objeto JSON { "<client_id>": { ... } }. O secret vai como HASH
# bcrypt (nunca em claro). Gere o hash com:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'MEU_SECRET', bcrypt.gensalt()).decode())"
#
# Campos de cada client:
#   secret_hash : hash bcrypt do client_secret (string)
#   subject     : identidade do serviço (ex: "svc:security-ci")
#   scopes      : lista de escopos permitidos (ex: ["security:*"])
#   tenant_id   : tenant lógico (ex: "pilot")
#
# Exemplo (uma linha — substitua o hash pelo seu):
# AS_CLIENTS_JSON={"security-ci":{"secret_hash":"$2b$12$COLOQUE_SEU_HASH_BCRYPT_AQUI","subject":"svc:security-ci","scopes":["security:read","security:scan","security:model"],"tenant_id":"pilot"}}
AS_CLIENTS_JSON=

# Secret do client de demo (só usado quando AS_CLIENTS_JSON está vazio — dev).
AS_DEMO_SECRET=dev-secret-change-me

# ----------------------------------------------------------------------------
# Login da tela de consentimento (usuário final que aprova o OAuth).
# ----------------------------------------------------------------------------
# USER_STORE=postgres usa a tabela auth_users (bcrypt). Vazio/ausente = store
# in-memory com um usuário DEV seedado abaixo (SÓ dev).
USER_STORE=
AS_DEV_USER=dev
AS_DEV_PASSWORD=dev-password-change-me

# ----------------------------------------------------------------------------
# Federação SSO (OIDC upstream) — OPCIONAL. Se setar ISSUER + CLIENT_ID, a tela
# de consentimento ganha "Entrar via SSO" e delega o login ao IdP corporativo.
# Deixe vazio para usar só o login local (user store acima).
# ----------------------------------------------------------------------------
AS_UPSTREAM_OIDC_NAME=SSO
AS_UPSTREAM_OIDC_ISSUER=
AS_UPSTREAM_OIDC_CLIENT_ID=
AS_UPSTREAM_OIDC_CLIENT_SECRET=
# Precisa apontar para o callback público via Caddy:
AS_UPSTREAM_OIDC_REDIRECT_URI=https://mcp.suaempresa.com/auth/oauth/sso/callback
AS_UPSTREAM_OIDC_SCOPES=openid email profile

# ----------------------------------------------------------------------------
# Portas internas (raramente precisam mudar; são só de rede privada).
# ----------------------------------------------------------------------------
SECURITY_MCP_PORT=7100
GATEWAY_PORT=8080

# ----------------------------------------------------------------------------
# Banco/cache do MCP Gateway (SEM default sensível — preencha com o seu).
# ----------------------------------------------------------------------------
# ATENÇÃO: a rede `mcp-private` é `internal: true` (sem egress). Se o seu
# Postgres/Redis for EXTERNO ao compose, ou você adiciona esses serviços neste
# mesmo compose (na rede mcp-private), ou remove `internal: true` da rede.
# Ver DEPLOY_PILOT.md → "Postgres/Redis do gateway".
PG_HOST=postgres
PG_PORT=5432
PG_DB=platform_pilot
PG_USER=platform
PG_PASSWORD=troque-esta-senha

# Redis é opcional para o piloto (rate limit). Deixe vazio para desabilitar.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3
