# ============================================================================
# .env (recorte Keycloak) — federação SSO do auth-mcp via Keycloak
# ----------------------------------------------------------------------------
# Copie estes valores para o seu `.env` (junto com os demais de deploy/.env.example)
# e preencha CLIENT_ID/SECRET. Deixe o resto como está para o realm "mcp" abaixo.
#
# PRODUÇÃO: substitua <KC_HOST>/<REALM> pelo seu Keycloak; injete o SECRET via
# secrets manager (não comite).
# DEV LOCAL: use os valores do bloco "DEV" (Keycloak em deploy/keycloak/).
# ============================================================================

# ── Issuer do Keycloak (SEM barra final) ────────────────────────────────────
# Formato: https://<KC_HOST>/realms/<REALM>
AS_UPSTREAM_OIDC_NAME=Keycloak
AS_UPSTREAM_OIDC_ISSUER=https://<KC_HOST>/realms/mcp

# ── Client registrado no Keycloak (confidential) ────────────────────────────
AS_UPSTREAM_OIDC_CLIENT_ID=mcp-auth-mcp
AS_UPSTREAM_OIDC_CLIENT_SECRET=<COLE_O_SECRET_DO_CLIENT_AQUI>

# ── Callback público (via Caddy) — precisa estar em "Valid redirect URIs" ────
AS_UPSTREAM_OIDC_REDIRECT_URI=https://mcp.suaempresa.com/auth/oauth/sso/callback

# ── Scopes e mapeamento de roles ────────────────────────────────────────────
AS_UPSTREAM_OIDC_SCOPES=openid email profile
# Keycloak entrega roles do realm em realm_access.roles (nosso ROLE_CLAIM dotted path):
AS_UPSTREAM_OIDC_ROLE_CLAIM=realm_access.roles
# Mapeie as roles do realm → roles da plataforma:
AS_UPSTREAM_OIDC_ROLE_MAP={"mcp-admins":"admin","mcp-devs":"developer"}
AS_UPSTREAM_OIDC_DEFAULT_ROLE=developer

# ============================================================================
# DEV LOCAL (Keycloak de deploy/keycloak/docker-compose.keycloak.yml)
# ----------------------------------------------------------------------------
# Descomente para testar o fluxo federado REAL na sua máquina:
# AS_UPSTREAM_OIDC_ISSUER=http://localhost:8081/realms/mcp
# AS_UPSTREAM_OIDC_CLIENT_ID=mcp-auth-mcp
# AS_UPSTREAM_OIDC_CLIENT_SECRET=dev-mcp-client-secret
# AS_UPSTREAM_OIDC_REDIRECT_URI=http://localhost:7103/oauth/sso/callback
# (usuário demo do realm: alice / alice — role mcp-admins)
# ============================================================================
