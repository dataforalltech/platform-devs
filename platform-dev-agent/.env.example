# Copie para .env (gitignored) para o platform-dev-agent usar o GATEWAY REAL em vez do demo.
#   cp .env.example .env  &&  edite o PAT  &&  docker compose up -d
#
# O agente manda o PAT como Bearer; o gateway (platform-mcp) troca por um Twin Token
# de 15 min a cada chamada (PatResolver). PAT longevo => sem re-registro.
# Crie o PAT no admin: POST /api/v1/pats (ou reuse o registrado no Desktop).

DEV_GATEWAY_URL=http://host.docker.internal:8085/mcp
DEV_TENANT_ID=PLATFORM_DEV_30
DEV_GATEWAY_TOKEN=d4all_pat_XXXXXXXXXXXXXXXX
