# ai-governance-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:ai-governance-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
GOVERNANCE_LOG_LEVEL=INFO

# Knowledge-base (compute-only; a fonte de dados é o filesystem — NÃO há
# backend REST nem credencial de DB). Descomente para sobrescrever os defaults.
# GOVERNANCE_KB_PATH=./knowledge-base
# GOVERNANCE_SUGGESTIONS_PATH=
# GOVERNANCE_AUDIT_PATH=
