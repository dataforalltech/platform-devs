# terraform.tfvars.example — ambiente enxuto (HML / prod inicial).
# Segredos via env: export CLOUDFLARE_API_TOKEN=... ; credenciais AWS via SSO/role.

project     = "dataforall"
environment = "hml"
region      = "sa-east-1"
az          = "sa-east-1a"

# DNS / Tunnel — zona da Cloudflare (ex.: dataforall.tech)
domain                = "dataforall.tech"
cloudflare_zone_id    = "<zone-id>"
cloudflare_account_id = "<account-id>"

# Compute — 1 EC2 rodando tudo. Reduza p/ t3.large se rodar só um subconjunto.
instance_type = "t3.xlarge"
root_gib      = 40
data_gib      = 100

snapshot_retention_count = 7
# ecr_services = []   # por ora usa ACR (D3); liste serviços aqui se migrar p/ ECR
