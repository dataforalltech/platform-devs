# services-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
# Estas são EXATAMENTE as env vars lidas por src/config/settings.py (validation_alias),
# + VAULT_ADDR (lido em load_secret). Todos os valores abaixo são PLACEHOLDERS —
# NUNCA versione um segredo real.

# ── Ambiente (STD-SEC-004: um único .env; RUNTIME_ENV ∈ {local, cloud}) ──────
RUNTIME_ENV=local

# ── Integração com o gateway (STD-MCP-001 / STD-SEC-006) ─────────────────────
# Audiência exata re-verificada pelo PEP no inner token: mcp:<namespace>.
MCP_TWIN_AUDIENCE=mcp:services-mcp
# JWKS do platform-admin (emissor do twin/inner token) — OBRIGATÓRIO em cloud.
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# ── HTTP sidecar ─────────────────────────────────────────────────────────────
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# ── Backend do tenant (DBSettings — ORM canônico, dual-db) ───────────────────
# Fallback compartilhado: a credencial real do tenant vem de ADMIN_DATAFORALL.PLATFORMS.
# DB_ENGINE decide o dialeto (mysql/postgresql). A SENHA nunca é versionada (STD-SEC-004):
# defina DB_PASSWORD via env/secret manager, ou resolva via Vault (services-mcp/db_password).
DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASSWORD=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=30.0
DB_POOL_RECYCLE_SECONDS=1800
DB_QUERY_TIMEOUT_SECONDS=60
DB_HEALTH_POOL_SIZE=1
# DB_SSLMODE (opcional): deixe fora p/ manter None; ex.: DB_SSLMODE=require
# DB_SSLMODE=

# ── Conexão admin (AdminDBSettings — lê ADMIN_DATAFORALL.PLATFORMS) ──────────
# Resolve tenant -> credencial do seu banco (credencial-zero, ORM-H-12). ADMIN_DB_HOST e
# ADMIN_DB_PASSWORD são OBRIGATÓRIOS em cloud (enforce_security_invariants); a senha vem
# de env/Vault (services-mcp/admin_db_password), nunca de default no código.
ADMIN_DB_HOST=
ADMIN_DB_PORT=3306
ADMIN_DB_USER=root
ADMIN_DB_PASSWORD=

# ── Tuning das tools (discovery/health) ──────────────────────────────────────
SERVICES_HEALTH_TIMEOUT=3.0
SERVICES_DOCKER_TIMEOUT=10

# ── Vault (opcional): se VAULT_ADDR estiver setado, as senhas (DB_PASSWORD e
# ADMIN_DB_PASSWORD) são resolvidas via Vault (chaves services-mcp/db_password e
# services-mcp/admin_db_password), degradando p/ env se ausente.
# VAULT_ADDR=
