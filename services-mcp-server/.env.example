# services-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:services-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# Backend PostgreSQL (prefixo SERVICES_). A SENHA nunca é versionada (STD-SEC-004):
# defina SERVICES_PG_PASSWORD via env/secret manager ou resolva via Vault (abaixo).
SERVICES_PG_HOST=
SERVICES_PG_PORT=5432
SERVICES_PG_DB=services_mcp
SERVICES_PG_USER=postgres
SERVICES_PG_PASSWORD=

# Vault (opcional): se VAULT_ADDR estiver setado, a senha do DB é resolvida via
# Vault (chave services-mcp/pg_password), com degradação graciosa p/ env se ausente.
# VAULT_ADDR=

# Descoberta eager no boot (docker ps + port scan) — opt-in (I/O pesado).
SERVICES_SYNC_ON_STARTUP=false
