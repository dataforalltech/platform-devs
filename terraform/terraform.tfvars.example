# terraform.tfvars.example — copie para terraform.tfvars e ajuste.
# Segredos NÃO ficam aqui:
#   export AWS_PROFILE=...           (ou credenciais AWS via SSO/role)
#   export CLOUDFLARE_API_TOKEN=...  (token com Zone:DNS:Edit na zona)

project     = "dataforall"
environment = "prod"
region      = "sa-east-1"
azs         = ["sa-east-1a", "sa-east-1c"]
vpc_cidr    = "10.0.0.0/16"

# DNS / TLS (D6/D7)
domain             = "dataforalltech.com"
cloudflare_zone_id = "<seu-zone-id>"
cloudflare_proxied = true

# Compute
key_name          = "<seu-keypair>"     # ou null (use SSM Session Manager)
app_instance_type = "t3.large"
app_manager_count = 3
app_node_count    = 2
vault_instance_type = "t3.small"

# Data tier — ajuste tamanho por store
# data_nodes = {
#   mysql-admin     = { instance_type = "t3.large",  data_gib = 100 }
#   mysql-tenant    = { instance_type = "t3.xlarge", data_gib = 200 }
#   postgres-tenant = { instance_type = "t3.xlarge", data_gib = 200 }
#   redis           = { instance_type = "t3.medium", data_gib = 30 }
#   kafka           = { instance_type = "t3.large",  data_gib = 100 }
# }

snapshot_retention_count = 14
