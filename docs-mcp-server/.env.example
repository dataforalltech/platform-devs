# docs-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
# TODOS os valores abaixo são PLACEHOLDERS — jamais versione segredo real.
RUNTIME_ENV=local

# ── Integração com o gateway (STD-MCP-001 / STD-SEC-006) ──────────────────────
# Audiência exata re-verificada pelo PEP no inner token (deve ser mcp:<namespace>).
MCP_TWIN_AUDIENCE=mcp:docs-mcp
# JWKS do platform-admin (emissor do twin/inner token). OBRIGATÓRIO em cloud.
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# ── HTTP sidecar ──────────────────────────────────────────────────────────────
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# ── Backend do tenant (DBSettings — ORM canônico, dual-db) ────────────────────
# Fallback compartilhado: a credencial real do tenant vem de ADMIN_DATAFORALL.PLATFORMS
# (credencial-zero). DB_ENGINE decide o dialeto (mysql|postgresql). A SENHA nunca é
# versionada (STD-SEC-004): defina DB_PASSWORD via env/secret manager ou Vault (abaixo).
DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASSWORD=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_QUERY_TIMEOUT_SECONDS=60
DB_HEALTH_POOL_SIZE=1
# DB_SSLMODE=              # opcional (ex.: require/verify-full); default: sem SSL

# ── Conexão admin (AdminDBSettings — lê ADMIN_DATAFORALL.PLATFORMS) ───────────
# Resolve tenant -> credencial do banco do tenant (credencial-zero, ORM-H-12).
# OBRIGATÓRIOS em cloud (enforce_security_invariants): ADMIN_DB_HOST + ADMIN_DB_PASSWORD.
ADMIN_DB_HOST=
ADMIN_DB_PORT=3306
ADMIN_DB_USER=root
ADMIN_DB_PASSWORD=

# ── Vault (opcional) ──────────────────────────────────────────────────────────
# Se VAULT_ADDR estiver setado, as senhas (tenant + admin) são resolvidas via Vault
# (chaves docs-mcp/db_password e docs-mcp/admin_db_password), degradando p/ env se ausente.
# VAULT_ADDR=
