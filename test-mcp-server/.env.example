# test-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:test-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# PostgreSQL (camada de store) — prefixo TEST_. A SENHA nunca fica no código:
# resolvida via Vault (se VAULT_ADDR) → env. Obrigatória em cloud.
TEST_PG_HOST=
TEST_PG_PORT=5432
TEST_PG_DB=app
TEST_PG_USER=postgres
TEST_PG_PASSWORD=
# TEST_PG_MIN_CONN=2
# TEST_PG_MAX_CONN=10

# Vault opcional (STD-SEC-004): se setado, a senha do DB é lida do Vault.
# VAULT_ADDR=
