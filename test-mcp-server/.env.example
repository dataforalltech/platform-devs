# test-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. NENHUM segredo real aqui — só PLACEHOLDERS;
# as senhas vêm de env/Vault em runtime, nunca do repositório.
# Este arquivo lista EXATAMENTE as env vars lidas por src/config/settings.py
# (validation_alias) + VAULT_ADDR (lido por src/config/secrets.py).

# ── Ambiente (discriminador; RUNTIME_ENV ∈ {local, cloud}) ────────────────────
RUNTIME_ENV=local

# ── Integração com o gateway (STD-MCP-001 / STD-SEC-006) ──────────────────────
MCP_TWIN_AUDIENCE=mcp:test-mcp
# JWKS do platform-admin (emissor do inner Twin Token). OBRIGATÓRIO em cloud
# (enforce_security_invariants falha o boot sem ele).
URL_ADMIN_TWIN_JWKS=

# ── HTTP sidecar ──────────────────────────────────────────────────────────────
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# ── Backend do tenant (DBSettings — ORM canônico, dual-db) ────────────────────
# DB_ENGINE decide o dialeto (mysql|postgresql). Estes DB_* são o fallback
# compartilhado; a credencial real do tenant vem de ADMIN_DATAFORALL.PLATFORMS.
DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=root
# Senha via Vault (se VAULT_ADDR) → env. OBRIGATÓRIA em cloud (nunca no código).
DB_PASSWORD=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_QUERY_TIMEOUT_SECONDS=60
DB_HEALTH_POOL_SIZE=1
# Opcional (ex.: require|verify-ca|verify-full); vazio = sem override de SSL.
DB_SSLMODE=

# ── Conexão admin (AdminDBSettings — resolve o tenant via PLATFORMS) ──────────
# ADMIN_DB_HOST e ADMIN_DB_PASSWORD são OBRIGATÓRIOS em cloud
# (enforce_security_invariants: resolução credencial-zero do tenant; sem default no código).
ADMIN_DB_HOST=
ADMIN_DB_PORT=3306
ADMIN_DB_USER=root
ADMIN_DB_PASSWORD=

# ── Vault opcional (STD-SEC-004) ──────────────────────────────────────────────
# Se setado, as senhas (DB_PASSWORD / ADMIN_DB_PASSWORD) são lidas do Vault e o
# env vira fallback. Vazio/ausente = usa os valores de env acima.
VAULT_ADDR=

# NOTA: o PAT do GitHub (libs privadas platform-*) é um secret de BUILD do Docker
# (--mount=type=secret,id=github_token), NÃO uma env var de runtime — por isso não
# aparece aqui. Ver Dockerfile / pyproject.toml.
