# pipeline-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
# Placeholders APENAS — nunca comite segredo real (STD-SEC-004 / STD-OBS-001).
RUNTIME_ENV=local

# ── Integração com o gateway (STD-MCP-001 / STD-SEC-006) ─────────────────────
# Audiência exata re-verificada no inner token pelo PEP (divergência → 401).
MCP_TWIN_AUDIENCE=mcp:pipeline-mcp
# JWKS do platform-admin (emissor do twin/inner token). Obrigatório em cloud.
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# ── HTTP sidecar ─────────────────────────────────────────────────────────────
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# ── Backend do tenant (DBSettings — ORM canônico, dual-db) ───────────────────
# Fallback compartilhado: a credencial real do tenant vem de ADMIN_DATAFORALL.
# PLATFORMS; estes DB_* são o fallback quando a PLATFORMS row não traz o campo.
# DB_ENGINE decide o dialeto (mysql|postgresql). Senha via env/Vault, NUNCA no código.
DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASSWORD=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_QUERY_TIMEOUT_SECONDS=60
DB_HEALTH_POOL_SIZE=1
# DB_SSLMODE — opcional (ex.: require/verify-full); vazio = default do dialeto.
DB_SSLMODE=

# ── Conexão admin (AdminDBSettings — lê ADMIN_DATAFORALL.PLATFORMS) ──────────
# Resolve tenant -> credencial do banco do tenant (credencial-zero, ORM-H-12).
# OBRIGATÓRIOS em cloud: ADMIN_DB_HOST e ADMIN_DB_PASSWORD (fail-fast no boot via
# enforce_security_invariants; sem default no código — STD-SEC-004).
ADMIN_DB_HOST=
ADMIN_DB_PORT=3306
ADMIN_DB_USER=root
ADMIN_DB_PASSWORD=

# ── Vault (opt-in de cloud) ──────────────────────────────────────────────────
# Se setado, DB_PASSWORD/ADMIN_DB_PASSWORD são resolvidos via Vault com degradação
# graciosa p/ env (o boot nunca quebra por Vault). Ver load_secret em settings.py.
# VAULT_ADDR=
