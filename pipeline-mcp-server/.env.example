# pipeline-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:pipeline-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# Backend PostgreSQL (STD-SEC-004: senha via env/Vault, NUNCA no código)
# Em cloud (RUNTIME_ENV=cloud) PG_PASSWORD é obrigatório (fail-fast no boot).
PG_HOST=
PG_PORT=5432
PG_DB=pipeline_mcp
PG_USER=postgres
PG_PASSWORD=
PG_MIN_CONN=2
PG_MAX_CONN=10

# GitHub (criação/merge de PRs durante promoções) — opcional em local
PIPELINE_GITHUB_TOKEN=
PIPELINE_GITHUB_ORG=

# Vault (opt-in de cloud): se setado, PG_PASSWORD é resolvido via Vault com
# degradação graciosa p/ env (boot nunca quebra por Vault). Ver load_secret.
# VAULT_ADDR=
