# session-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:session-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# Backend de sessões (prefixo SESSION_). O store é SQLite embarcado (hermético);
# as vars PostgreSQL abaixo ficam prontas para o dual-write da Fase 2.
# STD-SEC-004: NUNCA comite senha real. Em cloud, a senha é obrigatória e deve vir
# do Vault (defina VAULT_ADDR) ou de SESSION_PG_PASSWORD injetado pelo runtime.
SESSION_PG_HOST=
SESSION_PG_PORT=5432
SESSION_PG_DB=app
SESSION_PG_USER=postgres
SESSION_PG_PASSWORD=

# Opcional: endereço do Vault. Se setado, a senha do backend é resolvida via
# platform_crypto.VaultSecretsClient (com fallback gracioso para env).
# VAULT_ADDR=https://vault:8200
