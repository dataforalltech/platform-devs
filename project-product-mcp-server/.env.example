RUNTIME_ENV=local
ENVIRONMENT=development
DB_ENGINE=mysql
API_PORT=8000
HEALTH_PORT=9090
MCP_PORT=7121
ADMIN_DB_HOST=host.docker.internal
ADMIN_DB_PORT=3306
ADMIN_DB_NAME=ADMIN_DATAFORALL
ADMIN_DB_USER=change-me
ADMIN_DB_PASSWORD=change-me
READINESS_TENANT_ID=PLATFORM_DEV
JWT_ISSUER=https://platform-admin.local
JWT_AUDIENCE=platform-project-product
JWT_JWKS_URL=https://platform-admin.local/.well-known/jwks.json
# Credencial que a API ACEITA na própria /api/internal/* (papel de destino).
# Não é a que o sidecar apresenta ao chamar — ver INTERNAL_API_TOKEN__* abaixo.
INTERNAL_API_TOKEN=change-me
METRICS_ENABLED=true
METRICS_SCRAPE_TOKEN=change-me
RATE_LIMIT_STORAGE_URI=redis://:change-me@redis:6379/6
TRUSTED_PROXIES=[]
LOG_LEVEL=INFO
LOG_TEMP_FOLDER=/tmp/platform-project-product-logs
OTEL_SERVICE_NAME=platform-project-product
OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SERVICE_BASE_URL=http://platform-project-product-api:8000
SERVICE_READINESS_URL=http://platform-project-product-api:9090/health/ready
SERVICE_ALLOWED_HOSTS=["platform-project-product-api","localhost","127.0.0.1"]
PRIVATE_NETWORK_ENCRYPTED=false
GOVERNANCE_BASE_URL=http://platform-governance:8000
GOVERNANCE_ALLOWED_HOSTS=["platform-governance","host.docker.internal","localhost"]

# ── Credencial de saída do sidecar, UMA POR DESTINO ──────────────────────────
# STD-SEC-002, "Estratégia de migração", passo 1: o destino entra no NOME do
# segredo. Enquanto o nome for `internal_api_token`, existe um slot só por
# serviço e o compartilhamento entre destinos não é desvio de operação — é a
# única configuração possível.
#
#   Vault (cloud):  internal_api_token__<destino>     (hífens preservados)
#   env/.env:       INTERNAL_API_TOKEN__<DESTINO>     ('-' → '_', maiúsculas)
#
# <destino> é o metadata.name do service profile do serviço CHAMADO.
# Os dois valores DEVEM ser distintos entre si e distintos do INTERNAL_API_TOKEN
# acima: o boot recusa quando aceitar == apresentar, ou quando dois destinos
# compartilham o mesmo valor.
INTERNAL_API_TARGETS=platform-project-product,platform-governance
INTERNAL_API_TOKEN__PLATFORM_PROJECT_PRODUCT=change-me
INTERNAL_API_TOKEN__PLATFORM_GOVERNANCE=change-me-outro-valor
MCP_TWIN_AUDIENCE=mcp:portfolio
MCP_TWIN_ISSUER=platform-admin/twin
URL_ADMIN_TWIN_JWKS=https://platform-admin.local/api/v1/twin/jwks.json
IDENTITY_ALLOWED_HOSTS=["platform-admin.local"]
MCP_RATE_LIMIT_REQUESTS=120
MCP_RATE_LIMIT_WINDOW_SECONDS=60
MCP_RATE_LIMIT_KEY_PREFIX=mcp:project_product
MCP_RATE_LIMIT_CONNECT_TIMEOUT_SECONDS=2.0
