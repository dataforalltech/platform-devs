# config-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:config-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# Encriptação at-rest (Fernet): os valores ficam encriptados no value_encrypted.
# Chave Fernet do store em repouso. NUNCA versione um valor real (STD-SEC-004).
# Gere: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Em cloud é resolvida via Vault quando VAULT_ADDR está setado (fallback p/ esta env).
CONFIG_MCP_MASTER_KEY=
# Opcional (cloud): endpoint do Vault. Setado → segredos vêm do Vault (fallback env).
# VAULT_ADDR=

# ── Backend do tenant (ORM canônico, dual-db, credencial-zero) ─────────────────
# O serviço só conhece o tenant_id (dos claims do inner token); a credencial do banco
# do tenant vem de ADMIN_DATAFORALL.PLATFORMS. DB_* é o fallback compartilhado.
DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASSWORD=
# Conexão admin (lê PLATFORMS p/ resolver tenant → credencial). Obrigatória em cloud.
ADMIN_DB_HOST=
ADMIN_DB_PORT=3306
ADMIN_DB_USER=root
ADMIN_DB_PASSWORD=
