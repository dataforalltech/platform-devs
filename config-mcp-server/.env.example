# config-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:config-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# ConfigStore encriptado (estado local; o store É o backend — não há REST).
CONFIG_MCP_STORE_PATH=~/.config/dataforalltech/config.enc.json
# Chave Fernet do store em repouso. NUNCA versione um valor real (STD-SEC-004).
# Gere: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Em cloud é resolvida via Vault quando VAULT_ADDR está setado (fallback p/ esta env).
CONFIG_MCP_MASTER_KEY=
# Opcional (cloud): endpoint do Vault. Setado → master key vem do Vault (fallback env).
# VAULT_ADDR=
