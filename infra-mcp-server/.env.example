# infra-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:infra-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# Persistência do allocator — SQLite embarcado (NÃO há senha de banco).
# :memory: (dev/testes, sem persistência) | /data/allocator.db (persistente).
INFRA_DB_PATH=:memory:

# Segredo Fernet que cifra as chaves SSH privadas por VM (STD-SEC-004).
# URL-safe base64 de 32 bytes. VAZIO → chave efêmera por sessão (chaves SSH
# perdidas em restart). Em produção resolva via Vault (VAULT_ADDR) ou defina aqui.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INFRA_LEASE_SECRET=

# Provisionamento terraform (opcional). VAZIO → ImmediateProvisioner (mock).
INFRA_TF_MODULES_ROOT=
INFRA_COST_CAP_USD_MONTH=
