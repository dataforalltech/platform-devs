# infra-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
# TODOS os valores abaixo são PLACEHOLDERS — nunca comite segredo real.
# Só constam variáveis que src/config/settings.py (e config/secrets.py) realmente lê.
#
# Convenção de nomes: os campos de integração/gateway e de banco usam validation_alias,
# logo lêem as env-vars canônicas da plataforma SEM o prefixo INFRA_ (RUNTIME_ENV,
# MCP_TWIN_AUDIENCE, DB_HOST, ADMIN_DB_HOST, …). Os campos específicos do server
# (terraform/allocator/lease_secret) mantêm o prefixo INFRA_.

# ── Ambiente (STD-SEC-004: discriminador único) ──────────────────────────────
# local | cloud. Em cloud, invariantes de boot exigem JWKS do admin + conexão admin.
RUNTIME_ENV=local

# ── Integração com o gateway (STD-MCP-001 / STD-SEC-006) ─────────────────────
# Audiência exata re-verificada no inner token (deve ser mcp:<namespace>).
MCP_TWIN_AUDIENCE=mcp:infra-mcp
# JWKS do platform-admin (emissor do twin/inner token). OBRIGATÓRIO em cloud.
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# ── HTTP sidecar ─────────────────────────────────────────────────────────────
MCP_PORT=7100
# NUNCA true (STD-SEC-001: Swagger/OpenAPI jamais exposto; invariante de boot).
DOCS_ENABLED=false
# DEBUG | INFO | WARNING | ERROR
MCP_SERVICE_LOG_LEVEL=INFO

# ── Backend do tenant (ORM canônico, dual-db) ────────────────────────────────
# O allocator persiste tenant-scoped no ORM (banco-por-tenant no MySQL / schema-por-tenant
# no PG). Estes DB_* são o fallback compartilhado; a credencial real do tenant vem de
# ADMIN_DATAFORALL.PLATFORMS (resolução credencial-zero). DB_ENGINE decide o dialeto.
DB_ENGINE=mysql
DB_HOST=mysql.internal
DB_PORT=3306
DB_NAME=
DB_USER=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# Pool (asyncpg/aiomysql) — tuning opcional; defaults seguros no settings.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_QUERY_TIMEOUT_SECONDS=60
DB_HEALTH_POOL_SIZE=1
# TLS do banco do tenant (ex.: require | verify-full). Vazio → sem override.
DB_SSLMODE=

# ── Conexão admin (lê ADMIN_DATAFORALL.PLATFORMS p/ resolver o tenant) ───────
# OBRIGATÓRIO em cloud: enforce_security_invariants() falha o boot sem
# ADMIN_DB_HOST + ADMIN_DB_PASSWORD (resolução credencial-zero do tenant).
ADMIN_DB_HOST=admin-mysql.internal
ADMIN_DB_PORT=3306
ADMIN_DB_USER=CHANGE_ME_ADMIN_DB_USER
ADMIN_DB_PASSWORD=CHANGE_ME_ADMIN_DB_PASSWORD

# ── Segredos via Vault (STD-SEC-004, config/secrets.py) ──────────────────────
# Se setado, as senhas (db/admin_db) e o INFRA_LEASE_SECRET são resolvidos via Vault,
# degradando p/ estes env-vars se o Vault estiver indisponível. Vazio → só env.
VAULT_ADDR=

# ── Segredo Fernet que cifra as chaves SSH privadas por VM (STD-SEC-004) ─────
# URL-safe base64 de 32 bytes. VAZIO → chave efêmera por sessão (chaves SSH perdidas
# em restart). Em produção resolva via Vault (VAULT_ADDR) ou defina aqui.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INFRA_LEASE_SECRET=

# ── Provisionamento terraform (opcional) ─────────────────────────────────────
# VAZIO → ImmediateProvisioner (mock). Definir → TerraformProvisioner real.
INFRA_TF_MODULES_ROOT=
# Cap de custo mensal (USD) via infracost antes do apply. Vazio → sem cap.
INFRA_COST_CAP_USD_MONTH=
# Backend do state das VMs: local | s3 | azurerm | gcs.
INFRA_TF_BACKEND_TYPE=local
# JSON com config do backend remoto (obrigatório quando backend != local).
INFRA_TF_BACKEND_CONFIG_JSON=
# Timeout (s) do terraform apply na provisão de VM.
INFRA_PROVISION_TIMEOUT_SEC=300
# cwd default para o terraform CLI (cada tool aceita override por chamada).
INFRA_TERRAFORM_ROOT=

# ── Binários dos CLIs (default: descobertos via PATH) ────────────────────────
INFRA_TERRAFORM_BIN=terraform
INFRA_CHECKOV_BIN=checkov
INFRA_TFSEC_BIN=tfsec
INFRA_INFRACOST_BIN=infracost
INFRA_AZ_BIN=az

# ── Timeouts por operação (s) + truncamento de output ────────────────────────
INFRA_PLAN_TIMEOUT=120
INFRA_VALIDATE_TIMEOUT=30
INFRA_SCAN_TIMEOUT=180
INFRA_COST_TIMEOUT=60
INFRA_OUTPUT_MAX_CHARS=16000
# json | text
INFRA_LOG_FORMAT=json
