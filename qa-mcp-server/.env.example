# qa-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:qa-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# Backend PostgreSQL (STD-SEC-004: credencial só via env/Vault, NUNCA no código).
# Formato: postgresql://<user>:<senha>@<host>:5432/<db>. Deixe VAZIO fora de cloud
# (cai para o DSN local de dev). Obrigatório em cloud. Preencha com CHANGE_ME.
PG_DSN=

# Vault opt-in (STD-SEC-004). Se setado, a credencial do DB é resolvida via Vault
# com fallback gracioso para PG_DSN acima. Deixe VAZIO para usar só env.
VAULT_ADDR=

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO
