# qa-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:qa-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# ── Backend do tenant (ORM canônico, dual-db, credencial-zero) ────────────────
# A credencial REAL do banco do tenant vem de ADMIN_DATAFORALL.PLATFORMS (resolvida
# pela lib a partir do tenant_id dos claims). Estes DB_* são o fallback compartilhado.
# DB_ENGINE decide o dialeto (mysql | postgresql). STD-SEC-004: nunca senha no código.
DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASSWORD=

# ── Conexão admin (lê ADMIN_DATAFORALL.PLATFORMS p/ resolver tenant->credencial) ──
# Obrigatória em cloud (enforce_security_invariants). O db name é fixo ADMIN_DATAFORALL.
ADMIN_DB_HOST=
ADMIN_DB_PORT=3306
ADMIN_DB_USER=root
ADMIN_DB_PASSWORD=

# Vault opt-in (STD-SEC-004). Se setado, DB_PASSWORD/ADMIN_DB_PASSWORD são resolvidos via
# Vault com fallback gracioso para os valores acima. Deixe VAZIO para usar só env.
VAULT_ADDR=

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO
