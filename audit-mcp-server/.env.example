# audit-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:audit-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# Backend PostgreSQL (prefixo AUDIT_). A SENHA nunca é versionada (STD-SEC-004):
# defina AUDIT_PG_PASSWORD via env/secret manager ou resolva via Vault (abaixo).
AUDIT_PG_HOST=
AUDIT_PG_PORT=5432
AUDIT_PG_DB=app
AUDIT_PG_USER=postgres
AUDIT_PG_PASSWORD=
AUDIT_PG_MIN_CONN=2
AUDIT_PG_MAX_CONN=10

# Vault (opcional): se VAULT_ADDR estiver setado, a senha do DB é resolvida via
# Vault (chave audit-mcp/pg_password), com degradação graciosa p/ env se ausente.
# VAULT_ADDR=

# Auditoria / checkers (GitHub)
AUDIT_GITHUB_TOKEN=
AUDIT_GITHUB_ORG=dataforalltech
