# audit-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
# Todos os valores abaixo são PLACEHOLDERS — nunca versione segredo real.
# As chaves aqui são EXATAMENTE as lidas por src/config/settings.py.
RUNTIME_ENV=local

# ── Integração com o gateway (STD-MCP-001 / STD-SEC-006) ──────────────────────
# Audiência exata re-verificada pelo PEP no inner token (mcp:<namespace>).
MCP_TWIN_AUDIENCE=mcp:audit-mcp
# JWKS do platform-admin (emissor do twin/inner token). OBRIGATÓRIO em cloud
# (enforce_security_invariants): sem ele o PEP não re-verifica o inner token.
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# ── HTTP sidecar ──────────────────────────────────────────────────────────────
MCP_PORT=7100
# STD-SEC-001: Swagger/OpenAPI NUNCA exposto — mantenha false em todo ambiente.
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# ── Backend do tenant (ORM canônico, dual-db, credencial-zero) ────────────────
# DB_ENGINE decide o dialeto (mysql/postgresql). Os DB_* são o fallback
# compartilhado: a credencial real do tenant vem de ADMIN_DATAFORALL.PLATFORMS.
# STD-SEC-004: a SENHA nunca é versionada — defina via env/secret manager ou Vault.
DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASSWORD=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=30.0
DB_POOL_RECYCLE_SECONDS=1800
DB_QUERY_TIMEOUT_SECONDS=60
DB_HEALTH_POOL_SIZE=1
# TLS do backend do tenant (ex.: require / verify-ca / verify-full). Vazio = default.
DB_SSLMODE=

# ── Conexão admin (lê ADMIN_DATAFORALL.PLATFORMS p/ resolver o tenant) ────────
# ADMIN_DB_HOST e ADMIN_DB_PASSWORD são OBRIGATÓRIOS em cloud
# (enforce_security_invariants): resolução credencial-zero do tenant via PLATFORMS,
# sem default no código. A senha nunca é versionada (env/secret manager ou Vault).
ADMIN_DB_HOST=
ADMIN_DB_PORT=3306
ADMIN_DB_USER=root
ADMIN_DB_PASSWORD=

# ── Vault (opcional) ──────────────────────────────────────────────────────────
# Se VAULT_ADDR estiver setado, as senhas são resolvidas via Vault com degradação
# graciosa p/ env se ausente. Chaves: audit-mcp/db_password e
# audit-mcp/admin_db_password (ver _resolve_secrets em settings.py).
# VAULT_ADDR=

# ── Auditoria / checkers (GitHub) ─────────────────────────────────────────────
# Token específico do server (padrão *_GITHUB_TOKEN). Nunca versione o valor real.
AUDIT_GITHUB_TOKEN=
AUDIT_GITHUB_ORG=dataforalltech
# Caminho das policies de auditoria. Vazio = default (src/policies) no código.
AUDIT_POLICIES_PATH=
