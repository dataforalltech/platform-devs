# dev-twin-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:dev-twin-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# PostgreSQL Token Store (persistência da persona, prefixo TWIN_)
# STD-SEC-004: a SENHA nunca vai versionada — preencha localmente ou via Vault
# (VAULT_ADDR setado → segredo dev-twin-mcp/pg_password). Deixe vazio aqui.
TWIN_PG_HOST=
TWIN_PG_PORT=5432
TWIN_PG_DB=app
TWIN_PG_USER=postgres
TWIN_PG_PASSWORD=
TWIN_PG_MIN_CONN=2
TWIN_PG_MAX_CONN=10

# Token master das operações administrativas (register/revoke/rotate/list)
TWIN_ADMIN_TOKEN=

# Vault (opcional): se setado, a senha do DB é resolvida via platform_crypto
# VAULT_ADDR=
