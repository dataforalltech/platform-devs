# dev-twin-mcp — sidecar mcp_http (Model C). UM ÚNICO .env (STD-SEC-004).
# Copie para .env (gitignored) e ajuste. Discriminador de ambiente: RUNTIME_ENV.
RUNTIME_ENV=local

# Integração com o gateway (STD-MCP-001 / STD-SEC-006)
MCP_TWIN_AUDIENCE=mcp:dev-twin-mcp
URL_ADMIN_TWIN_JWKS=http://platform-admin:8000/api/v1/twin/jwks.json

# HTTP sidecar
MCP_PORT=7100
DOCS_ENABLED=false
MCP_SERVICE_LOG_LEVEL=INFO

# Backend do tenant (ORM canônico, dual-db). A credencial real do tenant vem de
# ADMIN_DATAFORALL.PLATFORMS; estes DB_* são o fallback compartilhado (shared-admin).
# DB_ENGINE decide o dialeto (mysql/postgresql). STD-SEC-004: senha via env/Vault.
DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASSWORD=

# Conexão admin (lê ADMIN_DATAFORALL.PLATFORMS p/ resolver tenant -> credencial).
# Em cloud (RUNTIME_ENV=cloud) ADMIN_DB_HOST/ADMIN_DB_PASSWORD são obrigatórios (fail-fast).
ADMIN_DB_HOST=
ADMIN_DB_PORT=3306
ADMIN_DB_USER=root
ADMIN_DB_PASSWORD=

# Token master das operações administrativas (register/revoke/rotate/list)
TWIN_ADMIN_TOKEN=

# Vault (opt-in de cloud): se setado, DB_PASSWORD/ADMIN_DB_PASSWORD são resolvidos via
# platform_crypto com degradação graciosa p/ env (boot nunca quebra por Vault).
# VAULT_ADDR=
